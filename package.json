{
  "name": "@rljson/bs",
  "version": "0.0.29",
  "description": "Blob storage interface and implementations for rljson",
  "homepage": "https://github.com/rljson/bs",
  "bugs": "https://github.com/rljson/bs/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/bs.git"
  },
  "main": "dist/bs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js && node scripts/deploy-conformance-tests.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "pnpm run test",
    "prepublishOnly": "pnpm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.3.0",
    "@tssuite/helix-js": "^0.5.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "~10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/hash": "0.0.19",
    "@rljson/json": "0.0.23",
    "@rljson/rljson": "0.0.81"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {}
  },
  "packageManager": "pnpm@10.11.0"
}
